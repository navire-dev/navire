# Copy this file to .env and replace every placeholder before starting Core.

# (optional) Container image tag selected by Compose. (default latest)
NAVIRE_IMAGE_TAG=0.0.1
# (optional) Host port published by Compose for the Core API. (default 8080)
NAVIRE_HOST_PORT=8080
# (optional) Timezone used only for human-readable logs. Protocol and persisted timestamps remain UTC. (default UTC)
TZ=America/Chicago
# (optional) Minimum log level emitted by Core. (default info)
NAVIRE_LOG_LEVEL=info
# (optional) Use development-friendly human-readable logs instead of structured JSON. (default true)
NAVIRE_PRETTY_LOG=true
# (optional) Trust forwarded client IP headers from an allowed proxy. (default true)
NAVIRE_EVENTS_TRUST_PROXY=true
# Required when proxy trust is enabled. Lists the proxies allowed to provide forwarded client IP headers.
NAVIRE_EVENTS_ALLOWED_PROXIES=172.19.0.0/16
# (optional) Restrict direct client access to these IP addresses or networks. (default all addresses)
NAVIRE_EVENTS_ALLOWED_CIDRS=10.0.0.0/16,127.0.0.1,::1
# (optional) Number of events accepted immediately per client IP. Must be set with the refill rate. (default disabled)
NAVIRE_EVENTS_RATE_LIMIT_BURST=
# (optional) Sustained event refill rate per client IP per minute. Must be set with the burst. (default disabled)
NAVIRE_EVENTS_RATE_LIMIT_REFILL_PER_MIN=
# (optional) Retention period for execution plans before cleanup. (default 30d)
NAVIRE_PLAN_RETENTION=30d
# (optional) Interval between execution plan cleanup passes. (default 1h)
NAVIRE_PLAN_CLEANUP_INTERVAL=1h
# (optional) Retention period for Core reporting events before cleanup. (default 24h)
NAVIRE_REPORTING_RETENTION=24h
# (optional) Interval between reporting cleanup passes. (default 1h)
NAVIRE_REPORTING_CLEANUP_INTERVAL=1h

# Host directories mounted into the container by compose.example.yml.
# Required when using the example Compose file. Directory containing provider endpoint files.
NAVIRE_TARGETS_HOST_DIR=/opt/navire/config/targets
# Required when using the example Compose file. Directory containing notification templates.
NAVIRE_TEMPLATES_HOST_DIR=/opt/navire/config/templates

# Redis/Valkey connection.
# Choose either REDIS_URI or the split variables below, never both.
# When using REDIS_URI, comment out the split variables and TLS variables below.
# (optional) Full Redis connection URI. Use rediss:// to enable TLS through the URI. (default empty)
REDIS_URI=
# Required when REDIS_URI is empty. Redis or Valkey host and optional port supplied separately below.
REDIS_ADDR=valkey.example.internal
# Required when REDIS_URI is empty. Redis or Valkey TCP port.
REDIS_PORT=6379
# (optional) Redis username used by ACL authentication. Leave empty for unauthenticated Redis. (default empty)
REDIS_USER=
# (optional) Redis password used by authentication. Leave empty for unauthenticated Redis. (default empty)
REDIS_PASSWORD=
# (optional) Redis logical database number. (default 0)
REDIS_DB=0
# (optional) Enable TLS for split Redis configuration. (default false)
REDIS_TLS_ENABLED=false
# (optional) Skip TLS certificate verification for controlled environments only. (default false)
REDIS_TLS_INSECURE_SKIP_VERIFY=false
# (optional) Maximum time allowed to establish a Redis connection. (default 5s)
REDIS_DIAL_TIMEOUT=5s
# (optional) Maximum time allowed for Redis reads. (default 3s)
REDIS_READ_TIMEOUT=3s
# (optional) Maximum time allowed for Redis writes. (default 3s)
REDIS_WRITE_TIMEOUT=3s
# (optional) Maximum number of connections in the Redis client pool. (default 10)
REDIS_POOL_SIZE=10
# (optional) Delay between Redis connection retries. (default 2s)
REDIS_RETRY_INTERVAL=2s
# (optional) Maximum warning period used while waiting for Redis. (default 10s)
REDIS_MAX_WAIT=10s
# (optional) Timeout for the Redis readiness ping. (default 5s)
REDIS_PING_TIMEOUT=5s
# (optional) Number of failed Redis attempts before warning logs are emitted. (default 3)
REDIS_WARN_THRESHOLD=3

# Required AES-256 key used to encrypt provider secrets in Core's runtime projection.
# Generate with: openssl rand -hex 32
NAVIRE_SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters
# Required AES-256 key used to encrypt URLs carried in Core-to-DSPC execution plans. Must match DSPC exactly.
# Generate with: openssl rand -hex 32
NAVIRE_DISPATCH_PLAN_KEY=replace-with-another-64-hex-characters
# Required secret used to authenticate DSPC registration and lifecycle messages. Must match DSPC exactly.
# Generate with: openssl rand -hex 32
NAVIRE_DSPC_REGISTRATION_SECRET=replace-with-another-64-hex-characters

# (optional) Provider credential used by Gotify endpoint files. (default empty)
GOTIFY_TOKEN=replace-with-gotify-token
# (optional) Provider credential used by Discord endpoint files. (default empty)
DISCORD_TOKEN=replace-with-discord-token
# (optional) Provider credential used by NTFY endpoint files. (default empty)
NTFY_TOKEN=replace-with-ntfy-token
