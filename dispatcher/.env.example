# Copy this file to .env and replace every placeholder before starting the DSPC.

# (optional) Container image tag selected by Compose. (default latest)
NAVIRE_IMAGE_TAG=0.0.1
# (optional) Timezone used only for human-readable logs. Protocol and persisted timestamps remain UTC. (default UTC)
TZ=America/Chicago
# (optional) Stable DSPC identifier used in registration, heartbeats and reporting. Hostname is used when empty. (default hostname)
DISPATCHER_ID=dspc-prod-1
# (optional) Minimum log level emitted by the DSPC. (default info)
DISPATCHER_LOG_LEVEL=info
# (optional) Use development-friendly human-readable logs instead of structured JSON. (default true)
DISPATCHER_PRETTY_LOG=true

# (optional) Core registration endpoint. HTTP is supported for development. Use HTTPS in production. (default http://localhost:8080)
NAVIRE_CORE_URL=https://navire.example.com

# Redis/Valkey connection. These settings must match Core's transport.
# Choose either REDIS_URI or the split variables below, never both.
# When using REDIS_URI, comment out the split variables and TLS variables below.
# (optional) Full Redis connection URI. Use rediss:// to enable TLS through the URI. (default empty)
REDIS_URI=
# Required when REDIS_URI is empty. Redis or Valkey host and optional port supplied separately below.
REDIS_ADDR=valkey.example.internal
# Required when REDIS_URI is empty. Redis or Valkey TCP port.
REDIS_PORT=6379
# (optional) Redis username used by ACL authentication. Leave empty for unauthenticated Redis. (default empty)
REDIS_USER=
# (optional) Redis password used by authentication. Leave empty for unauthenticated Redis. (default empty)
REDIS_PASSWORD=
# (optional) Redis logical database number. (default 0)
REDIS_DB=0
# (optional) Enable TLS for split Redis configuration. (default false)
REDIS_TLS_ENABLED=false
# (optional) Skip TLS certificate verification for controlled environments only. (default false)
REDIS_TLS_INSECURE_SKIP_VERIFY=false
# (optional) Maximum time allowed to establish a Redis connection. (default 5s)
REDIS_DIAL_TIMEOUT=5s
# (optional) Maximum time allowed for Redis reads. (default 3s)
REDIS_READ_TIMEOUT=3s
# (optional) Maximum time allowed for Redis writes. (default 3s)
REDIS_WRITE_TIMEOUT=3s
# (optional) Maximum number of connections in the Redis client pool. (default 10)
REDIS_POOL_SIZE=10
# (optional) Delay between Redis connection retries. (default 2s)
REDIS_RETRY_INTERVAL=2s
# (optional) Maximum warning period used while waiting for Redis. (default 10s)
REDIS_MAX_WAIT=10s
# (optional) Timeout for the Redis readiness ping. (default 5s)
REDIS_PING_TIMEOUT=5s
# (optional) Number of failed Redis attempts before warning logs are emitted. (default 3)
REDIS_WARN_THRESHOLD=3

# Required AES-256 key used to decrypt URLs and credentials carried in execution plans.
# Must match Core exactly. Generate with: openssl rand -hex 32
NAVIRE_DISPATCH_PLAN_KEY=replace-with-64-hex-characters
# Required secret used to authenticate DSPC registration and lifecycle messages.
# Must match Core exactly. Generate with: openssl rand -hex 32
NAVIRE_DSPC_REGISTRATION_SECRET=replace-with-another-64-hex-characters
